#querys
##tables
CREATE TABLE entry(
	id int NOT null AUTO_INCREMENT PRIMARY KEY,
    id_for_entry varchar(100) NOT null,
    entry_value DECIMAL(8, 2),
    entry_nature varchar(100) NOT null,
    entry_expected_date date NOT null,
    entry_type varchar(100) NOT null,
    entry_description varchar(255) NOT null,
    entry_recurrence varchar(100) NOT null,
    entry_qty_installments int DEFAULT 1,
    entry_effected boolean NOT null,
    entry_category varchar(100),
    entry_subcategory varchar(100)
)

CREATE TABLE credit_card(
	card_id INT NOT null AUTO_INCREMENT PRIMARY KEY,
	card_alias varchar(100) NOT null,
	card_adm varchar(100) NOT null,
	card_number char(4) NOT null,
	card_flag varchar(100) NOT null,
	card_expected_day varchar(2) NOT null
)

CREATE TABLE entry_credit_card(
    id_entry_credit_card int NOT null AUTO_INCREMENT PRIMARY KEY,
    fk_entry_card_id int NOT null,
    fk_entry_id int NOT null,
    FOREIGN KEY(fk_entry_id) REFERENCES entry(id),
    FOREING KEY(fk_entry_card_id) REFERENCES credit_card(card_id)
)

